{
  "schemaVersion": 2,
  "presetKey": "dungeon_hud_demo",
  "name": "地牢 HUD · 组合式示例",
  "canvas": {
    "width": 1280,
    "height": 720,
    "backgroundTop": "#101a35",
    "backgroundBottom": "#24162e",
    "gridSize": 20
  },
  "rootIds": [
    "map",
    "status",
    "next"
  ],
  "nodes": {
    "map": {
      "id": "map",
      "type": "label",
      "definitionVersion": 1,
      "name": "map",
      "parentId": null,
      "childIds": [],
      "layout": {
        "mode": "absolute",
        "x": 20,
        "y": 20,
        "width": 380,
        "height": 44,
        "zIndex": 0
      },
      "visible": true,
      "locked": false,
      "opacity": 1,
      "props": {
        "content": "等待地图",
        "fontSize": 22
      },
      "bindings": {
        "text": {
          "source": "map.name",
          "fallback": "等待地图"
        }
      }
    },
    "status": {
      "id": "status",
      "type": "label",
      "definitionVersion": 1,
      "name": "status",
      "parentId": null,
      "childIds": [],
      "layout": {
        "mode": "absolute",
        "x": 20,
        "y": 65,
        "width": 380,
        "height": 32,
        "zIndex": 0
      },
      "visible": true,
      "locked": false,
      "opacity": 1,
      "props": {
        "content": "",
        "fontSize": 16
      },
      "bindings": {
        "text": {
          "source": "map.status",
          "fallback": "加载中"
        }
      }
    },
    "next": {
      "id": "next",
      "type": "button",
      "definitionVersion": 1,
      "name": "next",
      "parentId": null,
      "childIds": [],
      "layout": {
        "mode": "absolute",
        "x": 20,
        "y": 110,
        "width": 190,
        "height": 42,
        "zIndex": 0
      },
      "visible": true,
      "locked": false,
      "opacity": 1,
      "props": {
        "content": "切换下一张地图",
        "action": "map.next",
        "fontSize": 16
      }
    }
  },
  "previewContext": {
    "map.name": "地图：示例",
    "map.status": "状态：已就绪"
  }
}
