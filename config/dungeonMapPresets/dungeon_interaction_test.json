  "components": {
    "spatial-attachment": [
      {
        "id": "environment:spatial-attachment",
        "entityId": "environment",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "map"
          }
        ]
      },
      {
        "id": "spawn:spatial-attachment",
        "entityId": "spawn",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "tile",
            "tileId": "tile:1,2"
          }
        ]
      },
      {
        "id": "arrival:spatial-attachment",
        "entityId": "arrival",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "tile",
            "tileId": "tile:1,2"
          }
        ]
      },
      {
        "id": "guide:spatial-attachment",
        "entityId": "guide",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "tile",
            "tileId": "tile:1,3"
          }
        ]
      },
      {
        "id": "notice:spatial-attachment",
        "entityId": "notice",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "tile",
            "tileId": "tile:1,2"
          }
        ]
      },
      {
        "id": "once-notice:spatial-attachment",
        "entityId": "once-notice",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [{ "kind": "tile", "tileId": "tile:0,2" }]
      },
      {
        "id": "step-point:spatial-attachment",
        "entityId": "step-point",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "tile",
            "tileId": "tile:2,2"
          }
        ]
      },
      {
        "id": "exit:spatial-attachment",
        "entityId": "exit",
        "type": "spatial-attachment",
        "version": 1,
        "targets": [
          {
            "kind": "tile",
            "tileId": "tile:2,2"
          }
        ]
      }
    ],
    "scene-environment": [
      {
        "id": "environment:scene-environment",
        "entityId": "environment",
        "type": "scene-environment",
        "version": 3,
        "presetKey": "interaction-test-ground",
        "mapAnchorMode": "first-tile",
        "mapOffset": [
          0,
          0,
          0
        ],
        "tileSpacing": [
          8,
          8
        ],
        "tileSize": [
          7.5,
          0.5,
          7.5
        ]
      }
    ],
    "actor-spawn": [
      {
        "id": "spawn:actor-spawn",
        "entityId": "spawn",
        "type": "actor-spawn",
        "version": 1
      }
    ],
