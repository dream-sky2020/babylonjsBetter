{
  "schemaVersion": 3,
  "identity": {
    "id": "dungeon-map:dungeon_interaction_test",
    "presetKey": "dungeon_interaction_test",
    "name": "NPC 与地块交互测试场"
  },
  "grid": {
    "width": 5,
    "height": 5,
    "topologyMode": "bounded"
  },
  "terrain": {
    "default": {
      "walkable": true
    }
  },
  "entities": [
    {
      "id": "environment",
      "entityType": "map",
      "name": "交互测试场景",
      "enabled": true
    },
    {
      "id": "spawn",
      "entityType": "spawn-point",
      "name": "玩家出生点",
      "enabled": true
    },
    {
      "id": "arrival",
      "entityType": "dungeon-entrance",
      "name": "返回入口",
      "enabled": true
    },
    {
      "id": "guide",
      "entityType": "dungeon-agent",
      "name": "向导 NPC",
      "enabled": true
    },
    {
      "id": "notice",
      "entityType": "interaction-point",
      "name": "蓝格 (1,2) · 可重复调查",
      "enabled": true
    },
    {
      "id": "once-notice",
      "entityType": "interaction-point",
      "name": "蓝格 (0,2) · 每次进入只调查一次",
      "enabled": true
    },
    {
      "id": "step-point",
      "entityType": "interaction-point",
      "name": "进入地块的对话",
      "enabled": true
    },
    {
      "id": "exit",
      "entityType": "dungeon-exit",
      "name": "与地块对话重叠的传送出口",
      "enabled": true
    }
