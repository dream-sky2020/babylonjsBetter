      {
        "id": "arrival:dungeon-entrance",
        "entityId": "arrival",
        "type": "dungeon-entrance",
        "version": 1,
        "entranceId": "start",
        "facing": "north"
      }
    ],
    "spatial-body": [
      {
        "id": "guide:spatial-body",
        "entityId": "guide",
        "type": "spatial-body",
        "version": 1,
        "activeByDefault": true,
        "mobility": "movable",
        "pushable": false,
        "initialFacing": "north",
        "movementProfileId": "ground-four-way"
      }
    ],
    "spatial-collider": [
      {
        "id": "guide:spatial-collider",
        "entityId": "guide",
        "type": "spatial-collider",
        "version": 1,
        "response": "block",
        "footprint": "center",
        "shape": "disc",
        "radius": 0.3,
        "halfWidth": 0.5,
        "halfHeight": 0.5,
        "offsetX": 0,
        "offsetY": 0
      }
    ],
    "spatial-interaction": [
      {
        "id": "guide:spatial-interaction",
        "entityId": "guide",
        "type": "spatial-interaction",
        "version": 1,
        "onPlayerPush": "block"
      }
    ],
    "agent-timing": [
      {
        "id": "guide:agent-timing",
        "entityId": "guide",
        "type": "agent-timing",
        "version": 1,
        "actionPeriod": 1,
        "priority": 0
      }
    ],
    "agent-controller": [
      {
        "id": "guide:agent-controller",
        "entityId": "guide",
        "type": "agent-controller",
        "version": 1,
        "controllerId": "stationary",
        "parameters": {},
        "debugColor": "#f59e0b"
      }
    ],
    "event": [
      {
        "id": "guide:event",
        "entityId": "guide",
        "type": "event",
        "version": 2,
        "trigger": "interact",
        "targetRule": "front",
        "priority": 10,
        "action": {
          "type": "dialogue",
          "presetKey": "dialogue_test",
          "entryNodeId": "greeting"
        }
      },
      {
        "id": "notice:event",
        "entityId": "notice",
        "type": "event",
        "version": 2,
        "trigger": "interact",
        "targetRule": "self",
        "priority": 0,
        "once": false,
        "action": {
          "type": "dialogue",
          "presetKey": "dialogue_test",
          "entryNodeId": "repeat-notice"
        }
      },
      {
        "id": "once-notice:event",
        "entityId": "once-notice",
        "type": "event",
        "version": 2,
        "trigger": "interact",
        "targetRule": "self",
        "priority": 0,
        "once": true,
        "action": {
          "type": "dialogue",
          "presetKey": "dialogue_test",
          "entryNodeId": "once-notice"
        }
      },
      {
        "id": "step-point:event",
        "entityId": "step-point",
        "type": "event",
        "version": 2,
        "trigger": "enter",
        "targetRule": "self",
        "priority": 10,
        "action": {
          "type": "dialogue",
          "presetKey": "dialogue_test",
          "entryNodeId": "goodbye"
        }
      }
    ],
    "dungeon-exit": [
      {
        "id": "exit:dungeon-exit",
        "entityId": "exit",
        "type": "dungeon-exit",
        "version": 2,
        "targetMapPresetKey": "dungeon_interaction_room",
        "targetEntranceId": "start",
        "triggers": [
          "enter",
          "interact"
        ]
      }
    ]
