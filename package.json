{
  "name": "my-babylon-app",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck:clash": "tsc --noEmit -p tsconfig.clash.json",
    "lint": "eslint .",
    "test:batch": "node --experimental-strip-types --test core/entity/batch-edit.test.ts",
    "test:dungeon-map-definition": "node --experimental-strip-types --test core/map/dungeonMap.definition.test.ts",
    "test:dungeon-map-delta": "node --experimental-strip-types --test core/map/dungeonMap.delta.test.ts",
    "test:dungeon-map-structure-edit": "node --experimental-strip-types --test core/map/dungeonMap.structureEdit.test.ts",
    "test:dungeon-map-document": "node --experimental-strip-types --test core/map-document/dungeonMapDocument.test.ts",
    "test:dungeon-map-document-store": "node --experimental-strip-types --test core/map-document/dungeonMapDocument.store.test.ts",
    "test:dungeon-map-document-structure-edit": "node --experimental-strip-types --test core/map-document/dungeonMapDocument.structureEdit.test.ts",
    "test:dungeon-map-document-mutation-plan": "node --experimental-strip-types --test core/map-document/dungeonMapDocument.mutationPlan.test.ts",
    "test:dungeon-transition": "node --experimental-strip-types --test core/dungeon-transition/dungeonTransition.test.ts",
    "test:lab-communication": "node --experimental-strip-types --test tools/lab-kit/labCommunication.test.ts",
    "test:lab-execution-plan": "node --experimental-strip-types --test tools/lab-kit/execution-plan/resolveLabExecutionPlan.test.ts",
    "test:lab-services": "node --experimental-strip-types --test tools/lab-kit/labServiceRegistry.test.ts",
    "test:lab-state": "node --experimental-strip-types --test tools/lab-kit/lab-state/LabState.test.ts",
