    "migrate:animation-scene-presets": "node --experimental-strip-types scripts/migrateFirstPersonWeaponPresetsToAnimationScenes.ts",
    "preview": "vite preview",
    "verify:file": "electron scripts/verifyFileProtocol.cjs",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:1184/apps/mainGame/index.html && cross-env ELECTRON_RENDERER_URL=http://localhost:1184 electron .\""
