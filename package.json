    "test:dungeon-map-canvas-view": "node --experimental-strip-types --test core/ui/dungeon-map-canvas-view.test.ts",
    "test:dialogue-map": "node --experimental-strip-types --test core/dialogue-map/*.test.ts",
    "test:dungeon-runtime-map": "node --experimental-strip-types --test core/dungeon-runtime/dungeonRuntimeMap.test.ts",
