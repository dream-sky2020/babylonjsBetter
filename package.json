    "test:dungeon-navigation": "node --experimental-strip-types --test core/dungeon-navigation/*.test.ts",
    "test:dungeon-traversal": "node --experimental-strip-types --test core/dungeon-traversal/*.test.ts",
    "test:dungeon-movement": "node --experimental-strip-types --test core/dungeon-movement/*.test.ts",
    "test:dungeon-document-scene": "node --experimental-strip-types --test core/dungeon-player-spawn/dungeonPlayerSpawn.document.test.ts",
    "test:dungeon-libraries-references": "node --experimental-strip-types --test tools/lab-modules/dungeon/dungeon-libraries/dungeonLibraries.references.test.ts",
    "test:dungeon-map-loader-references": "node --experimental-strip-types --test tools/lab-modules/dungeon/dungeon-map-loader/dungeonMapLoader.references.test.ts",
