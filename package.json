{
  "name": "my-babylon-app",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck:clash": "tsc --noEmit -p tsconfig.clash.json",
    "lint": "eslint .",
    "test:batch": "node --experimental-strip-types --test core/entity/batch-edit.test.ts",
    "test:dungeon-map-definition": "node --experimental-strip-types --test core/map/dungeonMap.definition.test.ts",
    "test:dungeon-map-delta": "node --experimental-strip-types --test core/map/dungeonMap.delta.test.ts",
    "test:lab-communication": "node --experimental-strip-types --test tools/lab-kit/labCommunication.test.ts",
    "migrate:dungeon-map-definitions": "node --experimental-strip-types scripts/migrateDungeonMapDefinitions.ts",
    "preview": "vite preview",
    "verify:file": "electron scripts/verifyFileProtocol.cjs",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:1184/apps/mainGame/index.html && cross-env ELECTRON_RENDERER_URL=http://localhost:1184 electron .\""
  },
  "dependencies": {
    "@babylonjs/core": "^9.11.0",
    "@babylonjs/loaders": "^9.11.0",
    "@babylonjs/materials": "^9.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-static-copy": "^4.1.1",
    "wait-on": "^9.0.10"
  }
}
